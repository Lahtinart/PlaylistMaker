<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/track_item_min_height"
    android:paddingStart="@dimen/search_margin_start"
    android:paddingEnd="0dp"
    android:paddingTop="@dimen/track_item_padding_top"
    android:paddingBottom="@dimen/track_item_padding_bottom">

    <!-- Картинка трека -->
    <ImageView
        android:id="@+id/track_image"
        android:layout_width="@dimen/track_image_size"
        android:layout_height="@dimen/track_image_size"
        android:scaleType="centerCrop"
        android:contentDescription="@string/track_cover"
        android:background="@drawable/placeholder"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Название трека -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/track_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="?attr/colorOnBackground"
        android:textSize="@dimen/track_name_text_size"
        android:fontFamily="@font/ys_display_regular"
        android:textFontWeight="400"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginStart="@dimen/track_name_margin_start"
        android:layout_marginTop="@dimen/track_name_margin_top"
        android:layout_marginEnd="@dimen/search_margin_end"
        app:layout_constraintStart_toEndOf="@id/track_image"
        app:layout_constraintTop_toTopOf="@id/track_image"
        app:layout_constraintEnd_toStartOf="@id/arrow_icon" />

    <!-- Инфо о треке: артист и время -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/info_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/info_container_margin_top"
        app:layout_constraintStart_toStartOf="@id/track_name"
        app:layout_constraintTop_toBottomOf="@id/track_name"
        app:layout_constraintEnd_toStartOf="@id/arrow_icon">

        <!-- Имя артиста -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/artist_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textColor="@color/yp_text_gray"
            android:textSize="@dimen/info_text_size"
            android:fontFamily="@font/ys_display_regular"
            android:textFontWeight="400"
            android:maxLines="1"
            android:ellipsize="end"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/dot_icon"/>

        <!-- Точка -->
        <ImageView
            android:id="@+id/dot_icon"
            android:layout_width="@dimen/dot_icon_size"
            android:layout_height="@dimen/dot_icon_size"
            android:layout_marginStart="@dimen/dot_icon_margin_horizontal"
            app:layout_constraintStart_toEndOf="@id/artist_name"
            app:layout_constraintTop_toTopOf="@id/artist_name"
            app:layout_constraintBottom_toBottomOf="@id/artist_name"
            app:layout_constraintEnd_toStartOf="@id/track_time"
            android:contentDescription="@null"/>

        <!-- Время трека -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/track_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/yp_text_gray"
            android:textSize="@dimen/info_text_size"
            android:fontFamily="@font/ys_display_regular"
            android:textFontWeight="400"
            app:layout_constraintStart_toEndOf="@id/dot_icon"
            app:layout_constraintTop_toTopOf="@id/artist_name"
            app:layout_constraintBottom_toBottomOf="@id/artist_name"
            app:layout_constraintEnd_toEndOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Стрелочка справа -->
    <ImageView
        android:id="@+id/arrow_icon"
        android:layout_width="@dimen/arrow_icon_size"
        android:layout_height="@dimen/arrow_icon_size"
        android:src="@drawable/arrow_forward_light_mode"
        android:layout_marginEnd="@dimen/search_margin_end"
        android:contentDescription="@null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
